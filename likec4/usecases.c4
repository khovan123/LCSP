views {
  // Current Capstone Use Case catalog.
  // Canonical names and IDs are aligned with reports/Report3_Software_Requirement_Specification.md.
  // The previous UC-001..UC-017 implementation-oriented catalog is superseded.

  dynamic view uc_account_authentication {
    title 'Account & Authentication (UC-001..UC-007)'
    description 'Current authentication and account-access use cases.'

    complianceManager -> lcsp.web 'UC-001: Sign in with email'
    complianceManager -> lcsp.web 'UC-002: Sign in with identity provider'
    complianceManager -> lcsp.web 'UC-003: Complete MFA verification'
    complianceManager -> lcsp.web 'UC-004: Manage MFA settings'
    complianceManager -> lcsp.web 'UC-005: Request password recovery'
    complianceManager -> lcsp.web 'UC-006: Reset password'
    complianceManager -> lcsp.web 'UC-007: Sign out'
  }

  dynamic view uc_organization_collaboration {
    title 'Organization & Collaboration (UC-008..UC-013)'
    description 'Workspace, organization membership, and scoped Developer collaboration.'

    complianceManager -> lcsp.web 'UC-008: View workspace'
    complianceManager -> lcsp.web 'UC-009: View organization members'
    complianceManager -> lcsp.web 'UC-010: Invite Developer'
    complianceManager -> lcsp.web 'UC-011: Assign Developer access'
    complianceManager -> lcsp.web 'UC-012: Update Developer access'
    complianceManager -> lcsp.web 'UC-013: Revoke Developer access'
  }

  dynamic view uc_assessment_management {
    title 'Assessment Management (UC-014..UC-018)'
    description 'Assessment discovery, creation, continuation, and update.'

    complianceManager -> lcsp.web 'UC-014: View assessment list'
    complianceManager -> lcsp.web 'UC-015: Search assessments'
    complianceManager -> lcsp.web 'UC-016: Create assessment'
    complianceManager -> lcsp.web 'UC-017: Open or continue assessment'
    complianceManager -> lcsp.web 'UC-018: Update assessment information'
  }

  dynamic view uc_business_context {
    title 'Business Context (UC-019..UC-024)'
    description 'Guided business-context collection and readiness review.'

    complianceManager -> lcsp.web 'UC-019: Open business-context intake'
    complianceManager -> lcsp.web 'UC-020: Provide AI use-case information'
    complianceManager -> lcsp.web 'UC-021: Provide affected-people and data context'
    complianceManager -> lcsp.web 'UC-022: Provide decision-role and human-oversight information'
    complianceManager -> lcsp.web 'UC-023: Save intake progress'
    complianceManager -> lcsp.web 'UC-024: Review readiness and missing business information'
  }

  dynamic view uc_repository_project_version {
    title 'Repository & Project Version (UC-025..UC-029)'
    description 'Repository selection, access validation, project-version selection, and re-analysis.'

    complianceManager -> lcsp.web 'UC-025: Select connected repository'
    complianceManager -> lcsp.web 'UC-026: Validate repository access'
    complianceManager -> lcsp.web 'UC-027: Select project version'
    complianceManager -> lcsp.web 'UC-028: Change repository or project version'
    complianceManager -> lcsp.web 'UC-029: Re-run analysis for a new project version'
  }

  dynamic view uc_project_analysis_evidence {
    title 'Project Analysis & Evidence (UC-030..UC-035)'
    description 'Project analysis progress, AI-use findings, evidence review, and Developer technical review.'

    complianceManager -> lcsp.web 'UC-030: Start project analysis'
    complianceManager -> lcsp.web 'UC-031: Track analysis progress'
    complianceManager -> lcsp.web 'UC-032: Review AI-use findings'
    complianceManager -> lcsp.web 'UC-033: Review technical evidence'
    complianceManager -> lcsp.web 'UC-034: Review missing or insufficient evidence'
    developer -> lcsp.web 'UC-035: Review assigned technical findings'
  }

  dynamic view uc_conflict_clarification {
    title 'Conflict & Clarification (UC-036..UC-038)'
    description 'Review conflicting information, provide clarification, and confirm the assessment profile.'

    complianceManager -> lcsp.web 'UC-036: Review conflicting information'
    complianceManager -> lcsp.web 'UC-037: Provide requested clarification'
    developer -> lcsp.web 'UC-037: Provide requested clarification (scoped technical input)'
    complianceManager -> lcsp.web 'UC-038: Confirm assessment profile'
  }

  dynamic view uc_legal_requirements {
    title 'Legal Requirements (UC-039..UC-042)'
    description 'Legal requirement review, citations, reviewed legal sources, and assessment criteria.'

    complianceManager -> lcsp.web 'UC-039: Review applicable legal requirements'
    complianceManager -> lcsp.web 'UC-040: View legal source and citation'
    legalOperator -> lcsp.api 'UC-041: Maintain reviewed legal sources'
    legalOperator -> lcsp.api 'UC-042: Maintain assessment criteria'
  }

  dynamic view uc_assessment_results {
    title 'Assessment Results (UC-043..UC-044)'
    description 'Run the compliance assessment and review criterion-level results.'

    complianceManager -> lcsp.web 'UC-043: Run compliance assessment'
    complianceManager -> lcsp.web 'UC-044: Review assessment results'
  }

  dynamic view uc_gaps_reporting_history {
    title 'Gaps, Reporting & History (UC-045..UC-048)'
    description 'Compliance gap review, report generation/download, and assessment history.'

    complianceManager -> lcsp.web 'UC-045: Review compliance gaps'
    complianceManager -> lcsp.web 'UC-046: Generate assessment report'
    complianceManager -> lcsp.web 'UC-047: View or download generated report'
    complianceManager -> lcsp.web 'UC-048: Review assessment activity and prior versions'
  }
}
