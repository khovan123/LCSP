{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:fogewise": "node scripts/run.mjs fogewise",
    "dev:fogewise:reset": "node scripts/run.mjs fogewise_reset",
    "dev:stop": "node scripts/run.mjs dev_stop",
    "dev": "node scripts/run.mjs dev",
    "dev:trace": "LCSP_DEV_UNSAFE_TRACE=true ORCHESTRATION_DEBUG=true LOG_LEVEL=DEBUG NODE_ENV=development node scripts/run.mjs dev",
    "check:imports": "node scripts/check-import-policy.mjs",
    "check:contracts": "node scripts/check-contract-literals.mjs",
    "check:agentic-tools": "node scripts/check-agentic-tool-runtime.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "likec4:build": "likec4 build likec4 -o dist/likec4",
    "likec4:check": "likec4 check likec4",
    "likec4:dev": "likec4 dev likec4 --open false",
    "likec4:export": "likec4 export png likec4 -o dist/likec4-export",
    "lint": "pnpm run check:imports && pnpm run check:contracts && pnpm run check:agentic-tools && pnpm run typecheck",
    "prepare": "husky",
    "test": "pnpm run test:web && pnpm --filter @lcsp/api test:e2e",
    "test:web": "node --test tests/*.web.test.ts apps/web/tests/*.test.ts",
    "typecheck": "pnpm --filter @lcsp/api prisma:generate && pnpm exec tsc -b",
    "seed:legal-corpus:dev:dry": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/seed_legal_corpus_dev.py --dry-run",
    "seed:legal-corpus:dev": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/seed_legal_corpus_dev.py",
    "seed:legal-rules:dev:dry": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/seed_legal_rules_dev.py --bundle ./reports/legal-corpus-ocr/lcsp-precompiled-engineering-rules-vn-2026-08.json --corpus-version VN-LEGAL-2026-08 --catalog-version VN-LEGAL-RULES-2026-08-DEV --dry-run",
    "seed:legal-rules:dev": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/seed_legal_rules_dev.py --bundle ./reports/legal-corpus-ocr/lcsp-precompiled-engineering-rules-vn-2026-08.json --corpus-version VN-LEGAL-2026-08 --catalog-version VN-LEGAL-RULES-2026-08-DEV",
    "seed:rules:dry": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/import_lcsp_precompiled_engineering_rules.py --bundle ./reports/legal-corpus-ocr/lcsp-precompiled-engineering-rules-vn-2026-08.json --corpus-version VN-LEGAL-2026-08 --catalog-version VN-LEGAL-RULES-2026-08-DEV --dry-run",
    "seed:rules": "PYTHONPATH=lcsp-python-workers/src lcsp-python-workers/.venv/bin/python ./scripts/import_lcsp_precompiled_engineering_rules.py --bundle ./reports/legal-corpus-ocr/lcsp-precompiled-engineering-rules-vn-2026-08.json --corpus-version VN-LEGAL-2026-08 --catalog-version VN-LEGAL-RULES-2026-08-DEV",
    "seed:legal:dev": "pnpm seed:legal-corpus:dev && pnpm seed:legal-rules:dev && pnpm seed:rules"
  },
  "devDependencies": {
    "@lcsp/contracts": "workspace:*",
    "@lcsp/i18n": "workspace:*",
    "@lcsp/web": "workspace:*",
    "@prisma/compute-sdk": "^0.33.0",
    "@tanstack/ai": "^0.14.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "likec4": "^1.49.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.0"
  }
}
