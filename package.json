{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "run": "node scripts/run.mjs",
    "run:list": "node scripts/run.mjs list",
    "dev:proxy": "node scripts/run.mjs proxy",
    "dev:proxy:reset": "node scripts/run.mjs proxy_reset",
    "dev:infra": "node scripts/run.mjs infra",
    "dev:infra:reset": "node scripts/run.mjs infra_reset",
    "dev:stop": "node scripts/run.mjs stop",
    "dev:api": "node scripts/run.mjs api",
    "dev:web": "node scripts/run.mjs web",
    "dev:worker:scanner": "node scripts/run.mjs scanner",
    "dev:worker:technical-profile": "node scripts/run.mjs technical_profile",
    "dev:worker:ai-usage-flow": "node scripts/run.mjs ai_usage_flow",
    "dev:worker:conflict-detection": "node scripts/run.mjs conflict_detection",
    "dev:worker:verified-profile": "node scripts/run.mjs verified_profile",
    "dev:worker:legal-retrieval": "node scripts/run.mjs legal_retrieval",
    "dev:worker:classification": "node scripts/run.mjs classification",
    "dev:worker:gap-analysis": "node scripts/run.mjs gap_analysis",
    "dev:min": "node scripts/run.mjs min",
    "dev:local": "node scripts/run.mjs local",
    "dev:local:full": "node scripts/run.mjs local_full",
    "dev:all": "echo 'deprecated: use pnpm run dev:local:full' && node scripts/run.mjs local_full",
    "check:imports": "node scripts/check-import-policy.mjs",
    "check:contracts": "node scripts/check-contract-literals.mjs",
    "check:agentic-tools": "node scripts/check-agentic-tool-runtime.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "likec4:build": "likec4 build likec4 -o dist/likec4",
    "likec4:check": "likec4 check likec4",
    "likec4:dev": "likec4 dev likec4 --open false",
    "likec4:export": "likec4 export png likec4 -o dist/likec4-export",
    "lint": "pnpm run check:imports && pnpm run check:contracts && pnpm run check:agentic-tools && pnpm run typecheck",
    "prepare": "husky",
    "test": "pnpm run test:web && pnpm --filter @lcsp/api test:e2e",
    "test:web": "node --test tests/*.web.test.ts apps/web/tests/*.test.ts",
    "typecheck": "pnpm --filter @lcsp/api prisma:generate && pnpm exec tsc -b"
  },
  "devDependencies": {
    "@lcsp/contracts": "workspace:*",
    "@lcsp/i18n": "workspace:*",
    "@lcsp/web": "workspace:*",
    "@prisma/compute-sdk": "^0.33.0",
    "@tanstack/ai": "^0.14.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "likec4": "^1.49.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.0"
  }
}
