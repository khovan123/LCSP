{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check:imports": "node scripts/check-import-policy.mjs",
    "lint": "pnpm run check:imports && pnpm run typecheck",
    "test": "pnpm run test:web && pnpm --filter @lcsp/api test:e2e",
    "test:web": "node --test tests/story-1-1.web.test.ts",
    "typecheck": "pnpm --filter @lcsp/api prisma:generate && pnpm exec tsc -b"
  },
  "devDependencies": {
    "@prisma/compute-sdk": "^0.33.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.0"
  }
}
