{
  "name": "lcsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "check:imports": "node scripts/check-import-policy.mjs",
    "check:contracts": "node scripts/check-contract-literals.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "compute:build:api": "pnpm dlx @prisma/cli@latest app build api",
    "compute:deploy:api": "pnpm dlx @prisma/cli@latest app deploy api --no-db",
    "lint": "pnpm run check:imports && pnpm run check:contracts && pnpm run typecheck",
    "prepare": "husky",
    "test": "pnpm run test:web && pnpm --filter @lcsp/api test:e2e",
    "test:web": "node --test tests/*.web.test.ts apps/web/tests/*.test.ts",
    "typecheck": "pnpm --filter @lcsp/api prisma:generate && pnpm exec tsc -b"
  },
  "devDependencies": {
    "@lcsp/contracts": "workspace:*",
    "@lcsp/i18n": "workspace:*",
    "@lcsp/web": "workspace:*",
    "@prisma/compute-sdk": "^0.33.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.0"
  }
}
