{
  "schemaVersion": "1.0.0",
  "bundleId": "VN-AI-ENGINEERING-RULES-2026-08-PRECOMPILED",
  "contractVersion": "transparency-controls/2026-08-20.1",
  "templates": [
    {
      "templateId": "VN134_ART11_1_DIRECT_INTERACTION_DISCLOSURE",
      "investigationGoals": [
        "Trace direct human-facing AI interaction from AI output to the concrete user response surface.",
        "Find an explicit disclosure control that tells the user the interaction is with AI.",
        "Verify the disclosure is attached to the same interaction path rather than unrelated documentation or a generic AI dependency."
      ],
      "keywords": [
        "chatbot",
        "assistant",
        "bot",
        "ai assistant",
        "disclosure",
        "ai disclosure",
        "ai notice",
        "powered by ai",
        "interacting with ai"
      ],
      "requiredEvidence": [
        "DIRECT_AI_INTERACTION_SURFACE",
        "AI_INTERACTION_DISCLOSURE_CONTROL"
      ],
      "supportingEvidence": [
        "DISCLOSURE_ATTACHED_TO_DIRECT_INTERACTION_PATH",
        "DISCLOSURE_DELIVERY_SURFACE"
      ],
      "negativeEvidence": [
        "DIRECT_AI_INTERACTION_WITHOUT_DISCLOSURE_CONTROL"
      ]
    },
    {
      "templateId": "VN134_ART11_2_MACHINE_READABLE_MEDIA_MARK",
      "investigationGoals": [
        "Trace AI-generated or AI-modified audio, image, or video to storage, response, export, or publication surfaces.",
        "Find a machine-readable mark control such as provenance metadata, embedded watermarking, content credentials, or equivalent media metadata.",
        "Verify the mark is applied on the same AI-media output path before the media leaves the controlled pipeline."
      ],
      "keywords": [
        "image",
        "audio",
        "video",
        "media",
        "watermark",
        "metadata",
        "provenance",
        "c2pa",
        "content credentials",
        "xmp",
        "iptc",
        "exif",
        "manifest",
        "machine-readable"
      ],
      "requiredEvidence": [
        "AI_MEDIA_OUTPUT_SURFACE",
        "MACHINE_READABLE_MARK_CONTROL"
      ],
      "supportingEvidence": [
        "MACHINE_READABLE_MARK_APPLIED_ON_MEDIA_OUTPUT_PATH",
        "PROVENANCE_OR_WATERMARK_METADATA"
      ],
      "negativeEvidence": [
        "AI_MEDIA_OUTPUT_WITHOUT_MACHINE_READABLE_MARK_CONTROL"
      ]
    },
    {
      "templateId": "VN134_ART11_3_PUBLIC_CONTENT_NOTICE",
      "investigationGoals": [
        "Trace AI-generated or AI-modified content to a concrete public-facing publication surface.",
        "Find an explicit public notice or label control identifying the content as AI-generated or AI-modified where authenticity confusion can arise.",
        "Verify the notice is attached to the same publication path rather than a disconnected policy or documentation page."
      ],
      "keywords": [
        "public",
        "publish",
        "publication",
        "post",
        "feed",
        "article",
        "generated by ai",
        "ai-generated",
        "synthetic",
        "disclosure",
        "notice",
        "label"
      ],
      "requiredEvidence": [
        "PUBLIC_AI_CONTENT_SURFACE",
        "PUBLIC_AI_CONTENT_NOTICE_CONTROL"
      ],
      "supportingEvidence": [
        "PUBLIC_NOTICE_ATTACHED_TO_AI_CONTENT_PATH",
        "AUTHENTICITY_DISCLOSURE_METADATA_OR_LABEL"
      ],
      "negativeEvidence": [
        "PUBLIC_AI_CONTENT_WITHOUT_NOTICE_CONTROL"
      ]
    },
    {
      "templateId": "VN134_ART11_4_DEEPFAKE_LABEL",
      "investigationGoals": [
        "Trace AI-generated or AI-modified media that simulates a real person or event to its user/public output surface.",
        "Find a visible deepfake or simulated-media label control on that same media path.",
        "Distinguish an actual visible labeling implementation from generic AI output, watermark, model, or token-flow evidence."
      ],
      "keywords": [
        "deepfake",
        "face swap",
        "faceswap",
        "voice clone",
        "voice cloning",
        "lip sync",
        "synthetic person",
        "simulated person",
        "simulated event",
        "visible label",
        "overlay",
        "ai-generated"
      ],
      "requiredEvidence": [
        "DEEPFAKE_OR_SIMULATED_MEDIA_SURFACE",
        "VISIBLE_DEEPFAKE_LABEL_CONTROL"
      ],
      "supportingEvidence": [
        "DEEPFAKE_LABEL_ATTACHED_TO_MEDIA_PATH",
        "SIMULATED_PERSON_OR_EVENT_SIGNAL"
      ],
      "negativeEvidence": [
        "DEEPFAKE_MEDIA_WITHOUT_VISIBLE_LABEL_CONTROL"
      ]
    },
    {
      "templateId": "VN134_ART11_5_MAINTAIN_TRANSPARENCY",
      "investigationGoals": [
        "Trace AI output through transformation, storage, export, delivery, and publication boundaries where transparency metadata or labels can be preserved or lost.",
        "Find the applicable disclosure, notice, watermark, label, or provenance control on the output path.",
        "Identify stripping, bypass, alternate delivery, or transformation paths that can remove or omit the required transparency control."
      ],
      "keywords": [
        "disclosure",
        "notice",
        "label",
        "watermark",
        "provenance",
        "metadata",
        "preserve",
        "strip metadata",
        "remove watermark",
        "transcode",
        "export",
        "publish"
      ],
      "requiredEvidence": [
        "AI_OUTPUT_SURFACE",
        "TRANSPARENCY_CONTROL_PRESENT",
        "TRANSPARENCY_CONTROL_CONTINUITY"
      ],
      "supportingEvidence": [
        "TRANSPARENCY_CONTROL_ATTACHED_TO_OUTPUT_PATH",
        "TRANSPARENCY_CONTROL_PRESERVED_ACROSS_DELIVERY_BOUNDARIES"
      ],
      "negativeEvidence": [
        "AI_OUTPUT_PATH_STRIPS_OR_BYPASSES_TRANSPARENCY_CONTROL"
      ]
    },
    {
      "templateId": "VN134_ART15_1A_MEDIUM_TRANSPARENCY",
      "investigationGoals": [
        "Collect technical evidence for Article 11 transparency controls without assigning the legal risk tier.",
        "Trace AI output to the relevant direct-interaction, public-content, media, storage, export, or publication surface.",
        "Find an Article 11 disclosure, notice, visible label, machine-readable mark, or continuity control attached to the same output path."
      ],
      "keywords": [
        "disclosure",
        "notice",
        "label",
        "watermark",
        "machine-readable",
        "provenance",
        "c2pa",
        "content credentials",
        "ai-generated",
        "deepfake",
        "public",
        "chatbot"
      ],
      "requiredEvidence": [
        "AI_OUTPUT_SURFACE",
        "ARTICLE_11_TRANSPARENCY_CONTROL",
        "TRANSPARENCY_CONTROL_CONTINUITY"
      ],
      "supportingEvidence": [
        "DIRECT_INTERACTION_DISCLOSURE_CONTROL",
        "PUBLIC_CONTENT_NOTICE_CONTROL",
        "MACHINE_READABLE_MARK_CONTROL",
        "VISIBLE_DEEPFAKE_LABEL_CONTROL"
      ],
      "negativeEvidence": [
        "AI_OUTPUT_WITHOUT_APPLICABLE_ARTICLE_11_TRANSPARENCY_CONTROL"
      ],
      "unresolvedConditions": [
        "CONTENT_CONTEXT_OR_USER_CONFUSION_MAY_REQUIRE_NON_CODE_EVIDENCE",
        "RISK_TIER_APPLICABILITY_REQUIRES_DOWNSTREAM_LEGAL_CLASSIFICATION"
      ]
    }
  ]
}
