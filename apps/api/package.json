{
  "name": "@lcsp/api",
  "private": true,
  "version": "0.0.1",
  "description": "LCSP NestJS API application",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run prisma:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "cross-env XDG_CACHE_HOME=.cache prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "seed:google-admins": "tsx scripts/seed-google-admins.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config ./jest.config.ts",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config ./jest.config.ts --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config ./jest.config.ts --coverage",
    "test:debug": "cross-env NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --config ./jest.config.ts --runInBand",
    "test:e2e": "cross-env DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lcsp_api_test?schema=public pnpm run prisma:generate && node ./test/scripts/ensure-test-postgres.mjs && cross-env DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lcsp_api_test?schema=public NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config ./test/jest-e2e.ts",
    "test:auth-integration": "node ./test/scripts/ensure-test-postgres.mjs && cross-env DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lcsp_api_test?schema=public NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config ./test/jest-e2e.ts --runInBand --runTestsByPath test/auth-workspace.e2e-spec.ts test/oauth-login.e2e-spec.ts test/invite-developer.e2e-spec.ts test/accept-invitation.e2e-spec.ts test/revoke-membership.e2e-spec.ts test/developer-pbac.e2e-spec.ts test/audit-trail.e2e-spec.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./security": "./src/security.ts",
    "./main": "./src/main.ts",
    "./app.module": "./src/app.module.ts"
  },
  "dependencies": {
    "@lcsp/contracts": "file:../../packages/contracts",
    "@lcsp/i18n": "file:../../packages/i18n",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "amqplib": "^2.0.1",
    "joi": "^18.2.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.20.0"
  }
}
