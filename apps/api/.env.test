# Test-only defaults for MW-cfg-001 ConfigModule validation.
# process.env values (e.g. DATABASE_URL exported by the test:e2e script) always
# take precedence over this file, so it only fills in vars nothing else sets.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/lcsp_api_test?schema=public
AUTH_BCRYPT_COST=10
AUTH_SESSION_TTL_SECONDS=86400
JWT_SECRET=test-only-jwt-secret-at-least-32-characters-long
OAUTH_GITHUB_CLIENT_ID=test-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=test-github-client-secret
OAUTH_GOOGLE_CLIENT_ID=test-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=test-google-client-secret
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback
GITHUB_APP_SLUG=lcsp-app-test
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=test-only-private-key
GITHUB_APP_ALLOWED_REDIRECT_URIS=http://localhost:3000/api/github/app/callback
GITHUB_APP_CLIENT_ID=test-github-app-client-id
GITHUB_APP_CLIENT_SECRET=test-github-app-client-secret
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=lcsp.events.test
# No broker is available in most e2e specs; keep the outbox poller quiet (business rule 9
# already guarantees it can't crash the app) instead of spamming "unavailable" every 1s.
OUTBOX_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=60000
MFA_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PYTHON_WORKER_BASE_URL=http://localhost:8000
WORKER_API_KEY=test-only-worker-api-key-at-least-32-chars
