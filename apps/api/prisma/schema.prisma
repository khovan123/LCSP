generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthOrganization {
  id          String            @id
  slug        String            @unique
  name        String
  mfaRequired Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  auditEvents AuthAuditEvent[]
  decisions   AuthDecisionLog[]
  invitations AuthInvitation[]
  memberships AuthMembership[]
  policies    AuthPolicy[]
  sessions    AuthSession[]
}

model AuthUser {
  id               String                @id
  email            String                @unique
  passwordHash     String
  emailVerified    Boolean
  failedLoginCount Int
  lockUntil        DateTime?
  displayName      String?
  recoveryEmail    String?
  mfaRequired      Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  memberships      AuthMembership[]
  mfaRateLimit     AuthMfaRateLimit?
  recoveryRequests AuthRecoveryRequest[]
  sessions         AuthSession[]
  mfaEnrollment    AuthUserMfa?
  oauthIdentities  AuthOAuthIdentity[]
}

model AuthPolicy {
  id             String
  version        String
  actions        String[]
  subjectRole    String
  stateGate      AuthStateGate
  conditions     Json?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitations    AuthInvitation[]
  memberships    AuthMembership[]
  organization   AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([id, version])
  @@unique([organizationId, subjectRole, version])
  @@index([organizationId])
}

model AuthMembership {
  id                String               @id
  userId            String
  organizationId    String
  status            AuthMembershipStatus
  subjectAttributes Json
  policyId          String
  policyVersion     String
  revokedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy            AuthPolicy           @relation(fields: [policyId, policyVersion], references: [id, version])
  user              AuthUser             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model AuthInvitation {
  id                String               @id
  email             String
  organizationId    String
  state             AuthInvitationState
  emailVerified     Boolean
  membershipStatus  AuthMembershipStatus
  subjectAttributes Json
  policyId          String
  policyVersion     String
  expiresAt         DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy            AuthPolicy           @relation(fields: [policyId, policyVersion], references: [id, version])

  @@index([organizationId])
}

model AuthSession {
  id               String           @id
  userId           String
  organizationId   String
  tokenHash        String
  tokenFingerprint String           @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  mfaVerifiedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuthUserMfa {
  userId          String   @id
  encryptedSecret String
  enrolledAt      DateTime @default(now())
  user            AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthMfaOtpUsed {
  userId  String
  otpCode String
  usedAt  DateTime @default(now())

  @@id([userId, otpCode])
  @@index([userId, usedAt])
}

model AuthMfaRateLimit {
  userId      String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthRecoveryRequest {
  id               String    @id
  userId           String
  tokenHash        String
  tokenFingerprint String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthOAuthState {
  id          String   @id
  state       String   @unique
  nonce       String
  provider    String
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model AuthOAuthIdentity {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthAuditEvent {
  id             String             @id
  eventType      String
  actorId        String?
  organizationId String?
  resourceType   AuditResourceType?
  resourceId     String?
  decision       AuthDecision?
  reasonCode     String?
  correlationId  String
  sessionId      String?
  policyId       String?
  policyVersion  String?
  payload        Json
  createdAt      DateTime           @default(now())
  organization   AuthOrganization?  @relation(fields: [organizationId], references: [id])

  @@index([correlationId])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

model AuthDecisionLog {
  id             String                  @id
  organizationId String?
  resourceType   AuditResourceType
  resourceId     String
  action         String
  decision       AuthDecision
  reasonCode     AuthorizationReasonCode
  policyId       String?
  policyVersion  String?
  correlationId  String
  payload        Json
  createdAt      DateTime                @default(now())
  organization   AuthOrganization?       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([correlationId])
}

model OutboxMessage {
  id            String              @id
  aggregateType OutboxAggregateType
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  publishedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

model User {
  id          String   @id
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())
}

model Assessment {
  id             String           @id
  organizationId String
  ownerId        String
  name           String
  description    String?
  status         AssessmentStatus @default(WIZARD_IN_PROGRESS)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([ownerId])
}

model WizardProfile {
  id             String              @id
  assessmentId   String              @unique
  organizationId String
  ownerId        String
  version        Int                 @default(1)
  status         WizardProfileStatus @default(IN_PROGRESS)
  answers        Json
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([assessmentId])
  @@index([organizationId])
}

model ReadinessExport {
  id             String                @id
  assessmentId   String
  organizationId String
  ownerId        String
  version        Int                   @default(1)
  status         ReadinessExportStatus
  contentJson    Json?
  blockedReason  String?
  generatedAt    DateTime              @default(now())

  @@index([assessmentId])
  @@index([organizationId])
  @@unique([assessmentId, version])
}

model AuditExportRequest {
  id             String            @id
  organizationId String
  requestedById  String
  fromDate       DateTime
  toDate         DateTime
  status         AuditExportStatus @default(READY)
  version        Int               @default(1)
  checksumSha256 String
  contentJson    Json?
  correlationId  String
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([organizationId, createdAt])
  @@index([organizationId, version])
}

enum AuthMembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum AuthInvitationState {
  APPROVED
  PENDING
  CONSUMED
}

enum AuthDecision {
  ALLOW
  DENY
}

enum AuthStateGate {
  MEMBERSHIP_ACTIVE
}

enum AuditResourceType {
  AI_USAGE_FLOW
  ASSESSMENT
  ASSESSMENT_RECORD
  AUDIT_EXPORT_REQUEST
  AUTH_INVITATION
  AUTH_MEMBERSHIP
  AUTH_ORGANIZATION
  AUTH_SESSION
  CLASSIFICATION_RESULT
  CONFLICT_RECORD
  DOCUMENT_REQUEST
  GITHUB_APP_INSTALL_STATE
  HTTP_ROUTE
  LEGAL_RULE
  LEGAL_RULE_CATALOG_VERSION
  LEGAL_RULE_MATCH
  OUTBOX
  READINESS_EXPORT
  REPOSITORY_CONNECTION
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
  TECHNICAL_EVIDENCE_REPORT
  TECHNICAL_PROFILE
  VERIFIED_PROFILE
  WORKER_TASK
  WORKSPACE
  WIZARD_PROFILE
}

enum AuthorizationReasonCode {
  ACTION_NOT_GRANTED
  ACCOUNT_NOT_FOUND
  AUTHORIZED
  AUTHZ_EVALUATOR_FAILURE
  AUTHZ_POLICY_UNAVAILABLE
  AUTHZ_STATE_GATE_BLOCKED
  AUTHZ_SUBJECT_INCOMPLETE
  AUTHZ_TENANT_SCOPE_MISMATCH
  AUTH_REQUIRED
  EMAIL_VERIFICATION_REQUIRED
  EVALUATOR_ERROR
  INVALID_CREDENTIALS
  INVALID_INVITE_STATE
  INVALID_REDIRECT_URI
  LOAD_ERROR
  MEMBERSHIP_MISSING
  MFA_REQUIRED
  MFA_INVALID
  MFA_RATE_LIMITED
  OAUTH_CALLBACK_INVALID
  OAUTH_STATE_INVALID
  PBAC_DENIED
  PBAC_METADATA_MISSING
  POLICY_NOT_FOUND
  RECOVERY_INVALID
  SESSION_INVALID
  STATE_GATE_FAILED
  SUBJECT_ROLE_MISMATCH
  SUBJECT_ATTRIBUTE_MISSING
  TEMPORARY_LOCKED
  UNSUPPORTED_PROVIDER
  VALIDATION_FAILED
}

enum OutboxAggregateType {
  AI_USAGE_FLOW
  ASSESSMENT
  AUTH_USER
  CLASSIFICATION_RESULT
  DOCUMENT_REQUEST
  LEGAL_RULE_MATCH
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
  TECHNICAL_EVIDENCE_REPORT
  TECHNICAL_PROFILE
  VERIFIED_PROFILE
  WIZARD_PROFILE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DLQ
}

enum AssessmentStatus {
  WIZARD_IN_PROGRESS
  WIZARD_SUBMITTED
  EVIDENCE_REQUIRED
  SCAN_IN_PROGRESS
  CLASSIFICATION_LOCKED
  READY_FOR_REVIEW
}

enum WizardProfileStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum ReadinessExportStatus {
  GENERATED
  BLOCKED
}

enum AuditExportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

model RepositoryConnection {
  id                 String                     @id
  assessmentId       String?
  organizationId     String
  userId             String
  installationId     String
  repositoryId       String
  repositoryName     String
  repositoryFullName String
  defaultBranch      String
  permissions        Json
  status             RepositoryConnectionStatus @default(ACTIVE)
  connectedAt        DateTime                   @default(now())
  revokedAt          DateTime?

  @@unique([installationId, repositoryId])
  @@index([organizationId])
  @@index([assessmentId])
}

model RepositorySnapshot {
  id                 String                   @id
  assessmentId       String
  organizationId     String
  connectionId       String
  repositoryId       String
  repositoryFullName String
  branch             String?
  ref                String?
  commitSha          String
  providerMetadata   Json
  actorId            String
  status             RepositorySnapshotStatus @default(READY)
  createdAt          DateTime                 @default(now())

  @@index([assessmentId])
  @@index([connectionId])
  @@index([commitSha])
}

model RepositoryScanJob {
  id             String                      @id
  assessmentId   String
  snapshotId     String
  organizationId String
  idempotencyKey String                      @unique
  triggerSource  RepositoryScanTriggerSource
  status         RepositoryScanJobStatus     @default(QUEUED)
  attemptCount   Int                         @default(0)
  correlationId  String
  blockedReason  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([assessmentId])
  @@index([snapshotId])
}

model TechnicalEvidenceReport {
  id              String                   @id
  scanJobId       String                   @unique
  assessmentId    String
  organizationId  String
  snapshotId      String
  toolsVersion    Json
  configHash      Json
  evidencePayload Json
  privacyFlags    Json
  schemaVersion   String
  status          EvidenceAcceptanceStatus @default(ACCEPTED)
  rejectionReason String?
  createdAt       DateTime                 @default(now())

  @@index([assessmentId])
  @@index([scanJobId])
}

model TechnicalProfile {
  id               String                   @id @default(uuid())
  evidenceReportId String                   @unique
  assessmentId     String
  organizationId   String
  schemaVersion    String
  providerVersion  String
  profileData      Json
  privacyFlags     Json
  status           EvidenceAcceptanceStatus @default(ACCEPTED)
  rejectionReason  String?
  createdAt        DateTime                 @default(now())

  @@index([assessmentId])
}

model AIUsageFlow {
  id                 String                   @id @default(uuid())
  technicalProfileId String                   @unique
  assessmentId       String
  organizationId     String
  schemaVersion      String
  providerVersion    String
  claims             Json
  unknownUsages      Json
  privacyFlags       Json
  status             EvidenceAcceptanceStatus @default(ACCEPTED)
  rejectionReason    String?
  createdAt          DateTime                 @default(now())

  @@index([assessmentId])
}

model ConflictRecord {
  id               String               @id @default(uuid())
  aiUsageFlowId    String
  assessmentId     String
  organizationId   String
  conflictType     String
  conflictScore    Float
  scoreExplanation String
  evidenceRefs     Json
  status           ConflictRecordStatus @default(PENDING)
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  createdAt        DateTime             @default(now())

  @@index([assessmentId, status])
}

model VerifiedProfile {
  id              String                @id @default(uuid())
  aiUsageFlowId   String                @unique
  assessmentId    String
  organizationId  String
  schemaVersion   String
  providerVersion String
  profileData     Json
  gatesPassedAt   Json
  status          VerifiedProfileStatus @default(PENDING_APPROVAL)
  approvedAt      DateTime?
  approvedById    String?
  createdAt       DateTime              @default(now())

  @@index([assessmentId])
}

model ClassificationResult {
  id                 String                        @id @default(uuid())
  legalRuleMatchId   String?                       @unique
  verifiedProfileId  String?
  assessmentId       String
  organizationId     String
  schemaVersion      String?
  classificationData Json?
  guardrailStatus    ClassificationGuardrailStatus @default(PASSED)
  blockedReason      String?
  status             EvidenceAcceptanceStatus      @default(ACCEPTED)
  createdAt          DateTime                      @default(now())

  @@index([assessmentId])
}

model DocumentRequest {
  id                     String                @id
  assessmentId           String
  organizationId         String
  requestedById          String
  classificationResultId String
  documentType           DocumentType
  status                 DocumentRequestStatus @default(QUEUED)
  documentUrl            String?
  blockedReason          String?
  correlationId          String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([assessmentId, organizationId, documentType, status, createdAt])
  @@index([organizationId, createdAt])
}

model GitHubAppInstallState {
  id             String   @id
  state          String   @unique
  assessmentId   String?
  organizationId String
  userId         String
  redirectUri    String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model LegalRuleCatalogVersion {
  id         String                   @id @default(uuid())
  version    String
  status     LegalRuleLifecycleStatus @default(DRAFT)
  ruleRefs   Json
  createdAt  DateTime                 @default(now())
  approvedAt DateTime?

  @@index([status])
}

model LegalRule {
  id                        String                   @id @default(uuid())
  legalRuleId               String                   @unique
  legalRuleCatalogVersionId String
  ruleFamily                String
  requiredFacts             Json
  optionalFacts             Json?
  blockingFacts             Json?
  unknownFactPolicy         String
  citationLocatorRefs       Json
  status                    LegalRuleLifecycleStatus @default(DRAFT)
  authoredBy                String

  @@index([legalRuleCatalogVersionId])
}

model RuleApprovalRecord {
  id                        String                   @id @default(uuid())
  legalRuleCatalogVersionId String
  approvedBy                String
  status                    LegalRuleLifecycleStatus
  scopeDescription          String
  comments                  String?
  approvalDate              DateTime                 @default(now())

  @@index([legalRuleCatalogVersionId])
}

model LegalRuleMatch {
  id                        String                        @id @default(uuid())
  verifiedProfileId         String
  assessmentId              String
  organizationId            String
  corpusVersionId           String
  legalRuleCatalogVersionId String
  schemaVersion             String
  matches                   Json
  citationAllowlist         Json
  overallCoverageStatus     OverallCoverageStatus         @default(NO_CITATION)
  guardrailStatus           LegalRuleMatchGuardrailStatus @default(PASSED)
  blockedReason             String?
  status                    EvidenceAcceptanceStatus      @default(ACCEPTED)
  createdAt                 DateTime                      @default(now())

  @@index([assessmentId])
}

enum RepositoryConnectionStatus {
  ACTIVE
  REVOKED
}

enum RepositorySnapshotStatus {
  READY
}

enum RepositoryScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

enum RepositoryScanTriggerSource {
  MANUAL
  TRUSTED
}

enum EvidenceAcceptanceStatus {
  ACCEPTED
  REJECTED
}

enum ConflictRecordStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum VerifiedProfileStatus {
  PENDING_APPROVAL
  APPROVED
  AUTO_APPROVED
}

enum ClassificationGuardrailStatus {
  PASSED
  DEGRADED
  BLOCKED
}

enum LegalRuleMatchGuardrailStatus {
  PASSED
  BLOCKED
}

enum OverallCoverageStatus {
  NO_CITATION
  PARTIAL_CITATION
  COMPLETE_CITATION
}

enum DocumentRequestStatus {
  QUEUED
  GENERATING
  READY
  FAILED
  BLOCKED
}

enum DocumentType {
  FINAL_REPORT
  GAP_ANALYSIS
  READINESS_EXPORT
}

enum LegalRuleLifecycleStatus {
  DRAFT
  APPROVED
  REJECTED
}
