generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthOrganization {
  id          String            @id
  slug        String            @unique
  name        String
  mfaRequired Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  auditEvents AuthAuditEvent[]
  decisions   AuthDecisionLog[]
  invitations AuthInvitation[]
  memberships AuthMembership[]
  policies    AuthPolicy[]
  sessions    AuthSession[]
}

model AuthUser {
  id               String                @id
  email            String                @unique
  passwordHash     String
  emailVerified    Boolean
  failedLoginCount Int
  lockUntil        DateTime?
  displayName      String?
  recoveryEmail    String?
  mfaRequired      Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  memberships      AuthMembership[]
  mfaRateLimit     AuthMfaRateLimit?
  recoveryRequests AuthRecoveryRequest[]
  sessions         AuthSession[]
  mfaEnrollment    AuthUserMfa?
  oauthIdentities  AuthOAuthIdentity[]
}

model AuthPolicy {
  id             String
  version        String
  actions        String[]
  subjectRole    String
  stateGate      AuthStateGate
  conditions     Json?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  invitations    AuthInvitation[]
  memberships    AuthMembership[]
  organization   AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([id, version])
  @@unique([organizationId, subjectRole, version])
  @@index([organizationId])
}

model AuthMembership {
  id                String               @id
  userId            String
  organizationId    String
  status            AuthMembershipStatus
  subjectAttributes Json
  policyId          String
  policyVersion     String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy            AuthPolicy           @relation(fields: [policyId, policyVersion], references: [id, version])
  user              AuthUser             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model AuthInvitation {
  id                String               @id
  email             String
  organizationId    String
  state             AuthInvitationState
  emailVerified     Boolean
  membershipStatus  AuthMembershipStatus
  subjectAttributes Json
  policyId          String
  policyVersion     String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy            AuthPolicy           @relation(fields: [policyId, policyVersion], references: [id, version])

  @@index([organizationId])
}

model AuthSession {
  id               String           @id
  userId           String
  organizationId   String
  tokenHash        String
  tokenFingerprint String           @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  mfaVerifiedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuthUserMfa {
  userId          String   @id
  encryptedSecret String
  enrolledAt      DateTime @default(now())
  user            AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthMfaOtpUsed {
  userId  String
  otpCode String
  usedAt  DateTime @default(now())

  @@id([userId, otpCode])
  @@index([userId, usedAt])
}

model AuthMfaRateLimit {
  userId      String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthRecoveryRequest {
  id               String    @id
  userId           String
  tokenHash        String
  tokenFingerprint String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthOAuthState {
  id          String   @id
  state       String   @unique
  nonce       String
  provider    String
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model AuthOAuthIdentity {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthAuditEvent {
  id             String            @id
  eventType      String
  actorId        String?
  organizationId String?
  resourceType   String?
  resourceId     String?
  decision       AuthDecision?
  reasonCode     String?
  correlationId  String
  sessionId      String?
  policyId       String?
  policyVersion  String?
  payload        Json
  createdAt      DateTime          @default(now())
  organization   AuthOrganization? @relation(fields: [organizationId], references: [id])

  @@index([correlationId])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

model AuthDecisionLog {
  id             String            @id
  organizationId String?
  resourceType   String
  resourceId     String
  action         String
  decision       AuthDecision
  reasonCode     String
  policyId       String?
  policyVersion  String?
  correlationId  String
  payload        Json
  createdAt      DateTime          @default(now())
  organization   AuthOrganization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([correlationId])
}

model OutboxMessage {
  id            String    @id
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  publishedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

model User {
  id          String   @id
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())
}

model Assessment {
  id             String   @id
  organizationId String
  ownerId        String
  name           String
  description    String?
  status         String   @default("WIZARD_IN_PROGRESS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([ownerId])
}

model WizardProfile {
  id             String    @id
  assessmentId   String    @unique
  organizationId String
  ownerId        String
  version        Int       @default(1)
  status         String    @default("IN_PROGRESS")
  answers        Json
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([assessmentId])
  @@index([organizationId])
}

enum AuthMembershipStatus {
  invited
  active
  revoked
}

enum AuthInvitationState {
  approved
  pending
  consumed
}

enum AuthDecision {
  allow
  deny
}

enum AuthStateGate {
  membership_active
}
