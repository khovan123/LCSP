generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Safe schema comment to force PR webhook build trigger
}

model AuthOrganization {
  id                         String                        @id
  slug                       String                        @unique
  name                       String
  mfaRequired                Boolean                       @default(false)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  aiUsageFlows               AIUsageFlow[]
  assessmentRuntimeEvents    AssessmentRuntimeEvent[]
  assessments                Assessment[]
  auditEvents                AuthAuditEvent[]
  auditExportRequests        AuditExportRequest[]
  classificationResults      ClassificationResult[]
  classificationReviews      ClassificationReviewRequest[]
  conflictRecords            ConflictRecord[]
  decisions                  AuthDecisionLog[]
  documentRequests           DocumentRequest[]
  gitHubAppInstallStates     GitHubAppInstallState[]
  legalRuleMatches           LegalRuleMatch[]
  memberships                AuthMembership[]
  readinessExports           ReadinessExport[]
  repositoryConnections      RepositoryConnection[]
  repositoryScanJobs         RepositoryScanJob[]
  repositorySnapshots        RepositorySnapshot[]
  sessions                   AuthSession[]
  targetedReanalysisRequests TargetedReanalysisRequest[]
  technicalEvidenceReports   TechnicalEvidenceReport[]
  technicalProfiles          TechnicalProfile[]
  verifiedProfiles           VerifiedProfile[]
  wizardProfiles             WizardProfile[]
}

model AuthUser {
  id                        String                        @id
  email                     String                        @unique
  passwordHash              String
  emailVerified             Boolean
  failedLoginCount          Int
  lockUntil                 DateTime?
  displayName               String?
  recoveryEmail             String?
  primaryEmailAddressPolicy AuthPrimaryEmailAddressPolicy @default(ACCOUNT_EMAIL)
  backupEmailPolicy         AuthBackupEmailPolicy         @default(RECOVERY_EMAIL)
  role                      AuthUserRole                  @default(CUSTOMER)
  mfaRequired               Boolean                       @default(false)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  approvedVerifiedProfiles  VerifiedProfile[]             @relation("VerifiedProfileApprover")
  assessmentOwners          Assessment[]                  @relation("AssessmentOwner")
  auditExportRequests       AuditExportRequest[]          @relation("AuditExportRequester")
  classificationReviews     ClassificationReviewRequest[] @relation("ClassificationReviewRequester")
  documentRequests          DocumentRequest[]             @relation("DocumentRequestRequester")
  gitHubAppInstallStates    GitHubAppInstallState[]       @relation("GitHubAppInstallStateUser")
  memberships               AuthMembership[]
  mfaEnrollment             AuthUserMfa?
  mfaOtpUses                AuthMfaOtpUsed[]
  mfaRateLimit              AuthMfaRateLimit?
  mfaRecoveryCodes          AuthMfaRecoveryCode[]
  oauthIdentities           AuthOAuthIdentity[]
  oauthStates               AuthOAuthState[]              @relation("AuthOAuthStateUser")
  readinessExports          ReadinessExport[]             @relation("ReadinessExportOwner")
  recoveryRequests          AuthRecoveryRequest[]
  repositoryConnections     RepositoryConnection[]        @relation("RepositoryConnectionUser")
  repositorySnapshots       RepositorySnapshot[]          @relation("RepositorySnapshotActor")
  resolvedConflicts         ConflictRecord[]              @relation("ConflictRecordResolver")
  sessions                  AuthSession[]
  wizardProfiles            WizardProfile[]               @relation("WizardProfileOwner")
}

model AuthMembership {
  id             String               @id
  userId         String
  organizationId String
  status         AuthMembershipStatus
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AuthUser             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model AuthSession {
  id                        String           @id
  userId                    String
  organizationId            String
  tokenHash                 String
  tokenFingerprint          String           @unique
  expiresAt                 DateTime
  revokedAt                 DateTime?
  mfaVerifiedAt             DateTime?
  sensitiveActionVerifiedAt DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  organization              AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthStates               AuthOAuthState[]
  user                      AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuthUserMfa {
  userId          String    @id
  encryptedSecret String
  enrolledAt      DateTime  @default(now())
  verifiedAt      DateTime?
  user            AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthBackupEmailPolicy {
  ALL_VERIFIED
  RECOVERY_EMAIL
}

enum AuthPrimaryEmailAddressPolicy {
  ACCOUNT_EMAIL
  RECOVERY_EMAIL
}

model AuthMfaOtpUsed {
  userId  String
  otpCode String
  usedAt  DateTime @default(now())
  user    AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, otpCode])
  @@index([userId, usedAt])
}

model AuthMfaRateLimit {
  userId      String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthMfaRecoveryCode {
  id          String    @id
  userId      String
  codeHash    String
  batchId     String
  generatedAt DateTime  @default(now())
  usedAt      DateTime?
  revokedAt   DateTime?
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, batchId])
  @@index([userId, revokedAt, usedAt])
}

model AuthRecoveryRequest {
  id               String    @id
  userId           String
  tokenHash        String
  tokenFingerprint String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthOAuthState {
  id          String       @id
  state       String       @unique
  nonce       String
  provider    String
  redirectUri String
  expiresAt   DateTime
  userId      String?
  sessionId   String?
  createdAt   DateTime     @default(now())
  session     AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        AuthUser?    @relation("AuthOAuthStateUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId])
}

model AuthOAuthIdentity {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthAuditEvent {
  id             String             @id
  eventType      String
  actorId        String?
  organizationId String?
  resourceType   AuditResourceType?
  resourceId     String?
  decision       AuthDecision?
  reasonCode     String?
  correlationId  String
  sessionId      String?
  payload        Json
  createdAt      DateTime           @default(now())
  organization   AuthOrganization?  @relation(fields: [organizationId], references: [id])

  @@index([correlationId])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

model AuthDecisionLog {
  id             String                  @id
  actorId        String?
  sessionId      String?
  organizationId String?
  resourceType   AuditResourceType
  resourceId     String
  action         String
  decision       AuthDecision
  reasonCode     AuthorizationReasonCode
  correlationId  String
  payload        Json
  createdAt      DateTime                @default(now())
  organization   AuthOrganization?       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([correlationId])
}

model OutboxMessage {
  id            String              @id
  aggregateType OutboxAggregateType
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model Assessment {
  id                         String                        @id
  organizationId             String
  ownerId                    String
  name                       String
  description                String?
  status                     AssessmentStatus              @default(WIZARD_IN_PROGRESS)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  aiUsageFlows               AIUsageFlow[]
  classificationResults      ClassificationResult[]
  classificationReviews      ClassificationReviewRequest[]
  conflictRecords            ConflictRecord[]
  documentRequests           DocumentRequest[]
  gitHubAppInstallStates     GitHubAppInstallState[]
  legalRuleMatches           LegalRuleMatch[]
  organization               AuthOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                      AuthUser                      @relation("AssessmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  readinessExports           ReadinessExport[]
  repositoryConnections      RepositoryConnection[]
  repositoryScanJobs         RepositoryScanJob[]
  repositorySnapshots        RepositorySnapshot[]
  runtimeEvents              AssessmentRuntimeEvent[]
  targetedReanalysisRequests TargetedReanalysisRequest[]
  technicalEvidenceReports   TechnicalEvidenceReport[]
  technicalProfiles          TechnicalProfile[]
  verifiedProfiles           VerifiedProfile[]
  wizardProfile              WizardProfile?

  @@index([organizationId, status])
  @@index([ownerId])
}

model WizardProfile {
  id               String              @id
  assessmentId     String              @unique
  organizationId   String
  ownerId          String
  version          Int                 @default(1)
  status           WizardProfileStatus @default(IN_PROGRESS)
  answers          Json
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assessment       Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization     AuthOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            AuthUser            @relation("WizardProfileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  verifiedProfiles VerifiedProfile[]

  @@index([assessmentId])
  @@index([organizationId])
}

model ReadinessExport {
  id             String                @id
  assessmentId   String
  organizationId String
  ownerId        String
  version        Int                   @default(1)
  status         ReadinessExportStatus
  contentJson    Json?
  blockedReason  String?
  generatedAt    DateTime              @default(now())
  assessment     Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization   AuthOrganization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          AuthUser              @relation("ReadinessExportOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@index([organizationId])
  @@index([assessmentId, version])
}

model AuditExportRequest {
  id             String            @id
  organizationId String
  requestedById  String
  fromDate       DateTime
  toDate         DateTime
  status         AuditExportStatus @default(READY)
  version        Int               @default(1)
  checksumSha256 String
  contentJson    Json?
  correlationId  String
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  organization   AuthOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    AuthUser          @relation("AuditExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, version])
}

enum AuthMembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum AuthDecision {
  ALLOW
  DENY
}

enum AuthUserRole {
  ADMIN
  CUSTOMER
}

enum AuditResourceType {
  AI_USAGE_FLOW
  ASSESSMENT
  ASSESSMENT_RECORD
  AUDIT_EXPORT_REQUEST
  AUTH_INVITATION
  AUTH_MEMBERSHIP
  AUTH_MFA_RECOVERY_CODE
  AUTH_ORGANIZATION
  AUTH_SESSION
  CLASSIFICATION_REVIEW_REQUEST
  CLASSIFICATION_RESULT
  CONFLICT_RECORD
  DOCUMENT_REQUEST
  GITHUB_APP_INSTALL_STATE
  HTTP_ROUTE
  LEGAL_RULE
  LEGAL_RULE_CATALOG_VERSION
  LEGAL_RULE_MATCH
  OUTBOX
  READINESS_EXPORT
  REPOSITORY_CONNECTION
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
  TECHNICAL_EVIDENCE_REPORT
  TECHNICAL_PROFILE
  VERIFIED_PROFILE
  WORKER_TASK
  WORKSPACE
  WIZARD_PROFILE
}

enum AuthorizationReasonCode {
  ACTION_NOT_GRANTED
  ACCOUNT_NOT_FOUND
  AUTHORIZED
  AUTHZ_EVALUATOR_FAILURE
  AUTHZ_POLICY_UNAVAILABLE
  AUTHZ_STATE_GATE_BLOCKED
  AUTHZ_SUBJECT_INCOMPLETE
  AUTHZ_TENANT_SCOPE_MISMATCH
  AUTH_REQUIRED
  EMAIL_VERIFICATION_REQUIRED
  EVALUATOR_ERROR
  INVALID_CREDENTIALS
  INVALID_INVITE_STATE
  INVALID_REDIRECT_URI
  LOAD_ERROR
  MEMBERSHIP_MISSING
  MFA_REQUIRED
  MFA_INVALID
  MFA_RATE_LIMITED
  OAUTH_CALLBACK_INVALID
  OAUTH_STATE_INVALID
  ORGANIZATION_MISMATCH
  PBAC_DENIED
  PBAC_METADATA_MISSING
  POLICY_NOT_FOUND
  REAUTH_REQUIRED
  RECOVERY_INVALID
  SESSION_INVALID
  STATE_GATE_FAILED
  SUBJECT_ROLE_MISMATCH
  SUBJECT_ATTRIBUTE_MISSING
  TEMPORARY_LOCKED
  UNSUPPORTED_PROVIDER
  VALIDATION_FAILED
}

enum OutboxAggregateType {
  AI_USAGE_FLOW
  ASSESSMENT
  AUTH_USER
  CLASSIFICATION_REVIEW_REQUEST
  CLASSIFICATION_RESULT
  DOCUMENT_REQUEST
  LEGAL_CORPUS_VERSION
  LEGAL_RULE_MATCH
  REPOSITORY_SCAN_JOB
  REPOSITORY_SNAPSHOT
  TECHNICAL_EVIDENCE_REPORT
  TECHNICAL_PROFILE
  TARGETED_REANALYSIS_REQUEST
  VERIFIED_PROFILE
  WIZARD_PROFILE
}

enum TargetedReanalysisRequestState {
  QUEUED
  DISPATCHED
  RUNNING
  COMPLETED
  FAILED
  DLQ
}

enum TargetedReanalysisCheckpointState {
  PENDING_DISPATCH
  DISPATCHED
  RUNNING
  RETRY_SCHEDULED
  COMPLETED
  FAILED
  DLQ
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DLQ
}

enum AssessmentStatus {
  WIZARD_IN_PROGRESS
  WIZARD_SUBMITTED
  EVIDENCE_REQUIRED
  SCAN_IN_PROGRESS
  CLASSIFICATION_LOCKED
  READY_FOR_REVIEW
}

enum WizardProfileStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum ReadinessExportStatus {
  GENERATED
  BLOCKED
}

enum AuditExportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

model RepositoryConnection {
  id                 String                     @id
  assessmentId       String?
  organizationId     String
  userId             String
  installationId     String
  repositoryId       String
  repositoryName     String
  repositoryFullName String
  defaultBranch      String
  permissions        Json
  status             RepositoryConnectionStatus @default(ACTIVE)
  connectedAt        DateTime                   @default(now())
  revokedAt          DateTime?
  assessment         Assessment?                @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  organization       AuthOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots          RepositorySnapshot[]
  user               AuthUser                   @relation("RepositoryConnectionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([installationId, repositoryId])
  @@index([organizationId])
  @@index([assessmentId])
}

model RepositorySnapshot {
  id                         String                      @id
  assessmentId               String
  organizationId             String
  connectionId               String
  repositoryId               String
  repositoryFullName         String
  branch                     String?
  ref                        String?
  commitSha                  String
  providerMetadata           Json
  actorId                    String
  status                     RepositorySnapshotStatus    @default(READY)
  createdAt                  DateTime                    @default(now())
  actor                      AuthUser                    @relation("RepositorySnapshotActor", fields: [actorId], references: [id], onDelete: Restrict)
  assessment                 Assessment                  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  connection                 RepositoryConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization               AuthOrganization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanJobs                   RepositoryScanJob[]
  targetedReanalysisRequests TargetedReanalysisRequest[]
  technicalEvidenceReports   TechnicalEvidenceReport[]

  @@index([assessmentId])
  @@index([connectionId])
  @@index([commitSha])
}

model RepositoryScanJob {
  id                        String                      @id
  assessmentId              String
  snapshotId                String
  organizationId            String
  idempotencyKey            String                      @unique
  triggerSource             RepositoryScanTriggerSource
  status                    RepositoryScanJobStatus     @default(QUEUED)
  attemptCount              Int                         @default(0)
  correlationId             String
  blockedReason             String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  assessment                Assessment                  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization              AuthOrganization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot                  RepositorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  targetedReanalysisRequest TargetedReanalysisRequest?
  technicalEvidenceReport   TechnicalEvidenceReport?

  @@index([assessmentId])
  @@index([snapshotId])
}

model TargetedReanalysisRequest {
  id                     String                         @id
  scanJobId              String                         @unique
  assessmentId           String
  organizationId         String
  inputEvidenceReportId  String
  snapshotId             String
  commitSha              String
  analyzerId             String
  normalizedScope        Json
  reasonRequirementId    String
  idempotencyKey         String
  state                  TargetedReanalysisRequestState @default(QUEUED)
  apiPublishAttempts     Int                            @default(0)
  workerDeliveryAttempts Int                            @default(0)
  checkpointRef          String
  outputEvidenceReportId String?
  safeFailureCode        String?
  correlationId          String
  checkpoint             TargetedReanalysisCheckpoint?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  assessment             Assessment                     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  inputEvidenceReport    TechnicalEvidenceReport        @relation("TargetedReanalysisInputEvidence", fields: [inputEvidenceReportId], references: [id], onDelete: Cascade)
  organization           AuthOrganization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outputEvidenceReport   TechnicalEvidenceReport?       @relation("TargetedReanalysisOutputEvidence", fields: [outputEvidenceReportId], references: [id], onDelete: SetNull)
  scanJob                RepositoryScanJob              @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  snapshot               RepositorySnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, state, createdAt])
  @@index([assessmentId, createdAt])
  @@index([inputEvidenceReportId])
  @@index([snapshotId])
}

model TargetedReanalysisCheckpoint {
  id                     String                            @id
  requestId              String                            @unique
  state                  TargetedReanalysisCheckpointState @default(PENDING_DISPATCH)
  apiPublishAttempts     Int                               @default(0)
  workerDeliveryAttempts Int                               @default(0)
  outputEvidenceReportId String?
  safeFailureCode        String?
  correlationId          String
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  request                TargetedReanalysisRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
}

model TechnicalEvidenceReport {
  id                        String                      @id
  scanJobId                 String                      @unique
  assessmentId              String
  organizationId            String
  snapshotId                String
  toolsVersion              Json
  configHash                Json
  evidencePayload           Json
  privacyFlags              Json
  schemaVersion             String
  status                    EvidenceAcceptanceStatus    @default(ACCEPTED)
  rejectionReason           String?
  createdAt                 DateTime                    @default(now())
  assessment                Assessment                  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization              AuthOrganization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanJob                   RepositoryScanJob           @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  snapshot                  RepositorySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  targetedReanalysisInputs  TargetedReanalysisRequest[] @relation("TargetedReanalysisInputEvidence")
  targetedReanalysisOutputs TargetedReanalysisRequest[] @relation("TargetedReanalysisOutputEvidence")
  technicalProfile          TechnicalProfile?
  verifiedProfiles          VerifiedProfile[]

  @@index([assessmentId])
  @@index([scanJobId])
}

model TechnicalProfile {
  id               String                   @id @default(uuid())
  evidenceReportId String                   @unique
  assessmentId     String
  organizationId   String
  schemaVersion    String
  providerVersion  String
  profileData      Json
  privacyFlags     Json
  status           EvidenceAcceptanceStatus @default(ACCEPTED)
  rejectionReason  String?
  createdAt        DateTime                 @default(now())
  aiUsageFlow      AIUsageFlow?
  assessment       Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidenceReport   TechnicalEvidenceReport  @relation(fields: [evidenceReportId], references: [id], onDelete: Cascade)
  organization     AuthOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model AIUsageFlow {
  id                 String                   @id @default(uuid())
  technicalProfileId String                   @unique
  assessmentId       String
  organizationId     String
  schemaVersion      String
  providerVersion    String
  claims             Json
  unknownUsages      Json
  privacyFlags       Json
  status             EvidenceAcceptanceStatus @default(ACCEPTED)
  rejectionReason    String?
  createdAt          DateTime                 @default(now())
  assessment         Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  conflictRecords    ConflictRecord[]
  organization       AuthOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technicalProfile   TechnicalProfile         @relation(fields: [technicalProfileId], references: [id], onDelete: Cascade)
  verifiedProfiles   VerifiedProfile[]

  @@index([assessmentId])
}

model ConflictRecord {
  id               String               @id @default(uuid())
  aiUsageFlowId    String
  assessmentId     String
  organizationId   String
  conflictType     String
  conflictScore    Float
  scoreExplanation String
  evidenceRefs     Json
  explanationBasis Json?
  status           ConflictRecordStatus @default(PENDING)
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?
  createdAt        DateTime             @default(now())
  aiUsageFlow      AIUsageFlow          @relation(fields: [aiUsageFlowId], references: [id], onDelete: Cascade)
  assessment       Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization     AuthOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resolvedBy       AuthUser?            @relation("ConflictRecordResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([assessmentId, status])
}

model AssessmentRuntimeEvent {
  id                String                     @id @default(uuid())
  organizationId    String
  assessmentId      String
  runId             String
  correlationId     String
  sequence          Int
  eventType         AssessmentRuntimeEventType
  runStatus         AssessmentRuntimeRunStatus
  stage             AssessmentRuntimeStage
  toolName          String?
  summary           String
  inputSummaryJson  Json?
  outputSummaryJson Json?
  errorSummary      String?
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  attempt           Int?
  waitingReason     String?
  createdAt         DateTime                   @default(now())
  assessment        Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  organization      AuthOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([assessmentId, createdAt])
  @@index([runId, sequence])
  @@index([organizationId, createdAt])
}

model VerifiedProfile {
  id                         String                   @id @default(uuid())
  aiUsageFlowId              String
  version                    Int                      @default(1)
  wizardProfileId            String?
  technicalEvidenceReportId  String?
  reconciliationDecisionRefs Json?
  idempotencyKey             String?
  assessmentId               String
  organizationId             String
  schemaVersion              String
  providerVersion            String
  profileData                Json
  gatesPassedAt              Json
  status                     VerifiedProfileStatus    @default(PENDING_APPROVAL)
  approvedAt                 DateTime?
  approvedById               String?
  createdAt                  DateTime                 @default(now())
  aiUsageFlow                AIUsageFlow              @relation(fields: [aiUsageFlowId], references: [id], onDelete: Cascade)
  approvedBy                 AuthUser?                @relation("VerifiedProfileApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assessment                 Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classificationResults      ClassificationResult[]
  legalRuleMatches           LegalRuleMatch[]
  organization               AuthOrganization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  technicalEvidenceReport    TechnicalEvidenceReport? @relation(fields: [technicalEvidenceReportId], references: [id], onDelete: SetNull)
  wizardProfile              WizardProfile?           @relation(fields: [wizardProfileId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, version])
  @@unique([organizationId, idempotencyKey])
  @@index([aiUsageFlowId])
  @@index([assessmentId])
  @@index([assessmentId, version])
}

model ClassificationResult {
  id                 String                        @id @default(uuid())
  legalRuleMatchId   String?                       @unique
  verifiedProfileId  String?
  assessmentId       String
  organizationId     String
  schemaVersion      String?
  classificationData Json?
  guardrailStatus    ClassificationGuardrailStatus @default(PASSED)
  blockedReason      String?
  status             EvidenceAcceptanceStatus      @default(ACCEPTED)
  createdAt          DateTime                      @default(now())
  assessment         Assessment                    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  documentRequests   DocumentRequest[]
  legalRuleMatch     LegalRuleMatch?               @relation(fields: [legalRuleMatchId], references: [id], onDelete: SetNull)
  organization       AuthOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifiedProfile    VerifiedProfile?              @relation(fields: [verifiedProfileId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
}

model ClassificationReviewRequest {
  id               String                            @id @default(uuid())
  legalRuleMatchId String
  assessmentId     String
  organizationId   String
  proposalGateRef  String
  baselineRef      String
  candidateLabel   String
  citationRefs     Json
  requestedById    String
  idempotencyKey   String
  status           ClassificationReviewRequestStatus @default(PENDING_INDEPENDENT_REVIEW)
  expiresAt        DateTime
  createdAt        DateTime                          @default(now())
  assessment       Assessment                        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  legalRuleMatch   LegalRuleMatch                    @relation(fields: [legalRuleMatchId], references: [id], onDelete: Cascade)
  organization     AuthOrganization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy      AuthUser                          @relation("ClassificationReviewRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([assessmentId, status])
  @@index([legalRuleMatchId])
}

model DocumentRequest {
  id                     String                @id
  assessmentId           String
  organizationId         String
  requestedById          String
  classificationResultId String
  documentType           DocumentType
  status                 DocumentRequestStatus @default(QUEUED)
  documentUrl            String?
  blockedReason          String?
  correlationId          String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  assessment             Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classificationResult   ClassificationResult  @relation(fields: [classificationResultId], references: [id], onDelete: Cascade)
  organization           AuthOrganization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy            AuthUser              @relation("DocumentRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([assessmentId, organizationId, documentType, status, createdAt])
  @@index([organizationId, createdAt])
}

model GitHubAppInstallState {
  id             String           @id
  state          String           @unique
  assessmentId   String?
  organizationId String
  userId         String
  redirectUri    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  assessment     Assessment?      @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  organization   AuthOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AuthUser         @relation("GitHubAppInstallStateUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model LegalRuleCatalogVersion {
  id               String                   @id @default(uuid())
  version          String
  status           LegalRuleLifecycleStatus @default(DRAFT)
  ruleRefs         Json
  createdAt        DateTime                 @default(now())
  approvedAt       DateTime?
  legalRuleMatches LegalRuleMatch[]
  rules            LegalRule[]
  approvals        RuleApprovalRecord[]

  @@index([status])
}

model LegalCorpusVersion {
  id                   String                   @id @default(uuid())
  version              String                   @unique
  status               LegalRuleLifecycleStatus @default(DRAFT)
  sourceManifest       Json
  integrityManifestRef String?
  createdAt            DateTime                 @default(now())
  approvedAt           DateTime?
  documents            LegalSourceDocument[]
  chunks               LegalDocumentChunk[]
  approvals            CorpusApprovalRecord[]
  legalRuleMatches     LegalRuleMatch[]
  retrievalIndexes     LegalRetrievalIndex[]

  @@index([status, createdAt])
}

model LegalRetrievalIndex {
  id                    String                    @id @default(uuid())
  legalCorpusVersionId  String
  version               String                    @unique
  status                LegalRetrievalIndexStatus @default(BUILDING)
  configHash            String
  contentHash           String
  validationManifestRef String?
  validatedAt           DateTime?
  createdAt             DateTime                  @default(now())
  corpusVersion         LegalCorpusVersion        @relation(fields: [legalCorpusVersionId], references: [id], onDelete: Cascade)

  @@index([legalCorpusVersionId, status, validatedAt])
}

model LegalSourceDocument {
  id                   String               @id @default(uuid())
  legalCorpusVersionId String
  documentId           String
  title                String
  sourceUrl            String
  sourceSha256         String
  effectiveDate        DateTime?
  sourceEffectStatus   String
  snapshotPath         String?
  createdAt            DateTime             @default(now())
  corpusVersion        LegalCorpusVersion   @relation(fields: [legalCorpusVersionId], references: [id], onDelete: Cascade)
  chunks               LegalDocumentChunk[]

  @@unique([legalCorpusVersionId, documentId])
  @@index([documentId])
}

model LegalSourceSnapshot {
  id                  String   @id @default(uuid())
  snapshotRef         String   @unique
  snapshotId          String   @unique
  catalogSourceRef    String
  adminCatalogVersion String
  documentId          String
  documentNumber      String?
  sourceUrl           String
  finalUrl            String?
  contentType         String
  byteLength          Int
  contentSha256       String
  snapshotObjectKey   String
  provenanceRef       String
  retrievedAt         DateTime
  sourceEffectStatus  String?
  normalizationSource String?
  identityVerified    Boolean  @default(false)
  correlationId       String
  createdAt           DateTime @default(now())

  @@index([catalogSourceRef, createdAt])
  @@index([documentId, createdAt])
  @@index([contentSha256])
}

model LegalDocumentChunk {
  id                    String              @id
  legalCorpusVersionId  String
  legalSourceDocumentId String
  documentId            String
  locator               String
  content               String
  contentSha256         String
  hierarchy             Json
  legalStatus           String
  pageStart             Int?
  pageEnd               Int?
  createdAt             DateTime            @default(now())
  corpusVersion         LegalCorpusVersion  @relation(fields: [legalCorpusVersionId], references: [id], onDelete: Cascade)
  sourceDocument        LegalSourceDocument @relation(fields: [legalSourceDocumentId], references: [id], onDelete: Cascade)

  @@unique([legalCorpusVersionId, documentId, locator])
  @@index([legalCorpusVersionId, documentId])
  @@index([legalCorpusVersionId, legalStatus])
}

model CorpusApprovalRecord {
  id                     String                   @id @default(uuid())
  legalCorpusVersionId   String
  approvedBy             String
  status                 LegalRuleLifecycleStatus
  idempotencyKey         String?
  integrityManifestRef   String?
  retrievalValidationRef String?
  outboxEventId          String?
  scopeDescription       String
  comments               String?
  approvalDate           DateTime                 @default(now())
  corpusVersion          LegalCorpusVersion       @relation(fields: [legalCorpusVersionId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([legalCorpusVersionId])
}

model LegalRule {
  id                        String                   @id @default(uuid())
  legalRuleId               String                   @unique
  legalRuleCatalogVersionId String
  ruleFamily                String
  requiredFacts             Json
  optionalFacts             Json?
  blockingFacts             Json?
  unknownFactPolicy         String
  citationLocatorRefs       Json
  status                    LegalRuleLifecycleStatus @default(DRAFT)
  authoredBy                String
  catalogVersion            LegalRuleCatalogVersion  @relation(fields: [legalRuleCatalogVersionId], references: [id], onDelete: Cascade)

  @@index([legalRuleCatalogVersionId])
}

model RuleApprovalRecord {
  id                        String                   @id @default(uuid())
  legalRuleCatalogVersionId String
  approvedBy                String
  status                    LegalRuleLifecycleStatus
  scopeDescription          String
  comments                  String?
  approvalDate              DateTime                 @default(now())
  catalogVersion            LegalRuleCatalogVersion  @relation(fields: [legalRuleCatalogVersionId], references: [id], onDelete: Cascade)

  @@index([legalRuleCatalogVersionId])
}

model LegalRuleMatch {
  id                        String                        @id @default(uuid())
  verifiedProfileId         String
  assessmentId              String
  organizationId            String
  corpusVersionId           String
  legalRuleCatalogVersionId String
  schemaVersion             String
  matches                   Json
  citationAllowlist         Json
  overallCoverageStatus     OverallCoverageStatus         @default(NO_CITATION)
  guardrailStatus           LegalRuleMatchGuardrailStatus @default(PASSED)
  blockedReason             String?
  status                    EvidenceAcceptanceStatus      @default(ACCEPTED)
  createdAt                 DateTime                      @default(now())
  assessment                Assessment                    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  catalogVersion            LegalRuleCatalogVersion       @relation(fields: [legalRuleCatalogVersionId], references: [id], onDelete: Restrict)
  classificationResult      ClassificationResult?
  classificationReviews     ClassificationReviewRequest[]
  corpusVersion             LegalCorpusVersion            @relation(fields: [corpusVersionId], references: [id], onDelete: Restrict)
  organization              AuthOrganization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifiedProfile           VerifiedProfile               @relation(fields: [verifiedProfileId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

enum RepositoryConnectionStatus {
  ACTIVE
  REVOKED
}

enum RepositorySnapshotStatus {
  READY
}

enum RepositoryScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  PENDING_MAPPING
  BLOCKED_MAPPING
  WAITING_FOR_CONTEXT
  READY_TO_SNAPSHOT
}

enum RepositoryScanTriggerSource {
  MANUAL
  TRUSTED
}

enum AssessmentRuntimeEventType {
  RUN_STARTED
  RUN_STAGE_CHANGED
  TOOL_STARTED
  TOOL_COMPLETED
  TOOL_FAILED
  TOOL_WAITING_INPUT
  TOOL_SKIPPED
  RUN_COMPLETED
  RUN_FAILED
}

enum AssessmentRuntimeRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

enum AssessmentRuntimeStage {
  SNAPSHOT
  SCAN
  TECHNICAL_EVIDENCE
  TECHNICAL_PROFILE
  AI_USAGE_FLOW
  RECONCILIATION
  CLASSIFICATION
  CONFLICTS
  DOCUMENTS
  LEGAL_RETRIEVAL
}

enum EvidenceAcceptanceStatus {
  ACCEPTED
  REJECTED
}

enum ConflictRecordStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum VerifiedProfileStatus {
  PENDING_APPROVAL
  APPROVED
  AUTO_APPROVED
  STALE
}

enum ClassificationGuardrailStatus {
  PASSED
  DEGRADED
  BLOCKED
}

enum ClassificationReviewRequestStatus {
  PENDING_INDEPENDENT_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum LegalRuleMatchGuardrailStatus {
  PASSED
  BLOCKED
}

enum OverallCoverageStatus {
  NO_CITATION
  PARTIAL_CITATION
  COMPLETE_CITATION
}

enum DocumentRequestStatus {
  QUEUED
  GENERATING
  READY
  FAILED
  BLOCKED
}

enum DocumentType {
  FINAL_REPORT
  GAP_ANALYSIS
  READINESS_EXPORT
}

enum LegalRuleLifecycleStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum LegalRetrievalIndexStatus {
  BUILDING
  VALID
  INVALID
}
